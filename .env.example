# ---------------------------------------------------------------------------
# FlowBoard environment template.
#
# Copy this file to .env.local and fill in real values:
#     cp .env.example .env.local
#
# .env.local is gitignored. This file is committed, so it must NEVER contain
# a real secret -- only the KEY names and safe placeholder values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# Anything without that prefix stays on the server. Never prefix a secret.
# ---------------------------------------------------------------------------

# Public base URL of the app. Used for absolute links and OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Postgres connection string. `docker compose up -d` starts a matching local
# database; see docker-compose.yml for the credentials it uses.
DATABASE_URL="postgresql://flowboard:flowboard_dev@localhost:5434/flowboard?schema=public"

# Signs and encrypts session cookies. Generate your own -- do not reuse anyone
# else's, and use a different value in every environment:
#     openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-generated-secret"

# ---------------------------------------------------------------------------
# AI features (optional)
#
# Works with ANY provider. Two adapters cover essentially everything:
#
#   anthropic  -- Anthropic's own API, via the official SDK. Gets adaptive
#                 thinking, effort control and server-side refusal fallbacks.
#   openai     -- anything speaking the OpenAI /chat/completions shape: OpenAI,
#                 Groq, Together, OpenRouter, Mistral, DeepSeek, Fireworks,
#                 vLLM, LM Studio, Ollama.
#
# Without a key the app runs normally and the AI panels show a short
# "not configured" note.
#
# NOTE: none of these carry a NEXT_PUBLIC_ prefix, so no key ever reaches the
# browser. Pages call isAIConfigured() on the SERVER and pass only a boolean.
# ---------------------------------------------------------------------------

# Which adapter to use: "anthropic" or "openai". Optional -- if omitted, an
# ANTHROPIC_API_KEY implies anthropic, and a bare AI_API_KEY implies openai.
# An unrecognised value disables AI rather than guessing.
AI_PROVIDER=""

# The API key. A provider-specific key (ANTHROPIC_API_KEY) wins over this one,
# so both can coexist while you switch providers.
AI_API_KEY=""

# Model id. Required for the openai adapter -- there is no default that is
# correct across OpenAI, Groq and Ollama simultaneously. Defaults to
# claude-opus-5 for anthropic.
AI_MODEL=""

# Base URL for the openai adapter. Defaults to https://api.openai.com/v1.
# Ignored by the anthropic adapter.
AI_BASE_URL=""

# Backwards compatible: a bare Anthropic key still works with no other config.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Example configurations ---------------------------------------------------
# Anthropic (the default):
#   ANTHROPIC_API_KEY="sk-ant-..."
#
# OpenAI:
#   AI_PROVIDER="openai"
#   AI_API_KEY="sk-..."
#   AI_MODEL="gpt-4.1"
#
# Groq:
#   AI_PROVIDER="openai"
#   AI_API_KEY="gsk_..."
#   AI_MODEL="llama-3.3-70b-versatile"
#   AI_BASE_URL="https://api.groq.com/openai/v1"
#
# OpenRouter:
#   AI_PROVIDER="openai"
#   AI_API_KEY="sk-or-..."
#   AI_MODEL="anthropic/claude-sonnet-4.5"
#   AI_BASE_URL="https://openrouter.ai/api/v1"
#
# Ollama, running locally and free:
#   AI_PROVIDER="openai"
#   AI_API_KEY="ollama"          # ignored by Ollama, but must be non-empty
#   AI_MODEL="llama3.2"
#   AI_BASE_URL="http://localhost:11434/v1"

# ---------------------------------------------------------------------------
# Redis (optional)
#
# Backs rate limiting. `npm run db:up` starts a matching local instance.
# With this unset the app still works -- rate limiting falls back to an
# in-memory limiter that is per-process and resets on restart.
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6380"
