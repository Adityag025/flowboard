# ---------------------------------------------------------------------------
# FlowBoard environment template.
#
# Copy this file to .env.local and fill in real values:
#     cp .env.example .env.local
#
# .env.local is gitignored. This file is committed, so it must NEVER contain
# a real secret -- only the KEY names and safe placeholder values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# Anything without that prefix stays on the server. Never prefix a secret.
# ---------------------------------------------------------------------------

# Public base URL of the app. Used for absolute links and OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
