# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; the template is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI agent skill files. `prisma init` downloads ~70 instruction files from
# github.com/prisma/skills into these paths and symlinks them where coding
# agents auto-load them. We removed them and ignore the paths so a future
# `prisma init` or `prisma generate` cannot silently reintroduce instructions
# for our tooling. Prisma's real documentation is on their site.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
